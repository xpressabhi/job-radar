  "roles": {
    "tracks": {
      "includePatterns": [
        { "label": "frontend", "pattern": "\\bfront[- ]?end\\b" },
        { "label": "react", "pattern": "\\breact\\b" },
        { "label": "next.js", "pattern": "\\bnext\\.?js\\b" },
        { "label": "web engineer", "pattern": "\\bweb (?:engineer|developer|platform)\\b" },
        { "label": "ui engineer", "pattern": "\\bui (?:software )?(?:engineer|developer)\\b" },
        { "label": "design engineer", "pattern": "\\bdesign (?:engineer|systems?)\\b" },
        { "label": "product engineer", "pattern": "\\bproduct engineer\\b" },
        { "label": "ai", "pattern": "\\bai\\b" },
        { "label": "ml", "pattern": "\\bml\\b|\\bmachine learning\\b|\\bdeep learning\\b" },
        { "label": "llm", "pattern": "\\bllms?\\b" },
        { "label": "genai", "pattern": "\\bgenai\\b|\\bgenerative ai\\b" },
        { "label": "agents", "pattern": "\\bagent(?:s|ic)?\\b" },
        { "label": "rag", "pattern": "\\brag\\b" },
        { "label": "evals", "pattern": "\\bevals?\\b|\\bevaluation\\b" },
        { "label": "mcp", "pattern": "\\bmcp\\b|\\bmodel context protocol\\b" },
        { "label": "nlp", "pattern": "\\bnlp\\b" },
        { "label": "applied ai/ml", "pattern": "\\bapplied (?:ai|ml)\\b" }
      ],
      "excludePatterns": [
        { "label": "leadership", "pattern": "\\b(?:manager|director|head of|vp|vice president)\\b" },
        { "label": "solutions/sales/support", "pattern": "\\b(?:solutions?|sales|gtm|go[- ]to[- ]market|presales|pre[- ]sales|support|customer|partner)\\b" },
        { "label": "analyst/people/recruiting", "pattern": "\\b(?:analyst|analytics|consult\\w*|recruit\\w*|talent|people|marketing|account|advocate|evangelist|hr|operations|strateg\\w*)\\b" },
        { "label": "architect", "pattern": "\\barchitect\\b" },
        { "label": "research/model", "pattern": "\\bresearch\\w*\\b|\\bscientist\\b|\\bpre[- ]?training\\b|\\bfoundational\\b|\\bsynthetic data\\b|\\bmultimodal\\b|\\bmodel (?:efficiency|training|serving)\\b|\\bml (?:systems|platform|infra)\\b|\\bmlops\\b|\\bml ops\\b" },
        { "label": "infra/ops", "pattern": "\\binfra(?:structure)?\\b|\\bsre\\b|\\bsite reliability\\b|\\bdevops\\b|\\bkubernetes\\b|\\bk8s\\b|\\bdistributed\\b|\\bnetworking\\b|\\bstorage\\b|\\bdatabases?\\b|\\bobservability\\b|\\bperformance engineer\\b|\\bkernels?\\b|\\bdeployment\\b|\\bdeployed\\b" },
        { "label": "security/qa/test", "pattern": "\\bsecurity\\b|\\bcompliance\\b|\\bpenetration\\b|\\bqa\\b|\\bquality\\b|\\btest(?:ing)?\\b|\\bsdet\\b" },
        { "label": "mobile", "pattern": "\\bmobile\\b|\\bios\\b|\\bandroid\\b|\\breact native\\b|\\bflutter\\b" },
        { "label": "backend/other", "pattern": "\\bbackend\\b|\\bback[- ]end\\b|\\bsap\\b|\\bsalesforce\\b|\\bzuora\\b|\\bdata\\b|\\bsearch\\b|\\bscalability\\b" }
      ]
    }
  },
  "pay": {
    "enabled": true,
    "currency": "INR",
    "floorAnnual": 5000000,
    "companyFloorAnnual": 2000000,
    "vettingRequired": true,
    "display": {
      "symbol": "₹",
      "divisor": 100000,
      "suffix": "L",
      "decimals": 1
    },
    "fxRates": {
      "INR": 1,
      "USD": 87,
      "EUR": 95,
      "GBP": 112,
      "CAD": 64,
      "AUD": 57,
      "SGD": 65
    },
    "fxNote": "Conservative (rounded down against the employee); reviewed quarterly."
  },
  "crawl": {
    "requestDelayMs": 1000,
    "timeoutMs": 20000,
    "retries": 1,
    "archiveMisses": 2
  },
  "llm": {
    "maxPerRun": 40
  }
